{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grandchallenge/.github/governance/credentials/credential-boundary.schema.json",
  "title": "Grand Challenge credential boundary inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "organization", "captured_at", "apps", "secret_metadata", "interactive_credentials", "break_glass", "deviations", "authority_boundaries"],
  "properties": {
    "schema_version": { "const": "gcl.credential-boundary.v1" },
    "inventory_id": { "const": "GCL-CREDENTIAL-BOUNDARY-001" },
    "organization": { "const": "grandchallenge" },
    "captured_at": { "type": "string", "format": "date-time" },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "app_id", "installation_id", "repository_selection", "permissions", "accountable_owner", "critical_functions", "credential_storage", "last_rotation", "next_review", "revocation_procedure"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "app_id": { "type": "integer", "minimum": 1 },
          "installation_id": { "type": "integer", "minimum": 1 },
          "repository_selection": { "enum": ["all", "selected"] },
          "permissions": { "type": "object", "minProperties": 1, "additionalProperties": { "enum": ["read", "write", "admin"] } },
          "accountable_owner": { "type": "string", "minLength": 1 },
          "critical_functions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "credential_storage": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "last_rotation": { "type": ["string", "null"], "format": "date-time" },
          "next_review": { "type": "string", "format": "date-time" },
          "revocation_procedure": { "type": "string", "minLength": 1 }
        }
      }
    },
    "secret_metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "storage_surface", "purpose", "accountable_owner", "created_at", "last_metadata_update_at", "rotation_state", "next_review"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "storage_surface": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "accountable_owner": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "last_metadata_update_at": { "type": "string", "format": "date-time" },
          "rotation_state": { "enum": ["observed_metadata_only", "verified_rotated"] },
          "next_review": { "type": "string", "format": "date-time" }
        }
      }
    },
    "interactive_credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "owner", "storage_surface", "scopes", "permitted_uses", "administrative_settings_path", "status", "next_review"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "storage_surface": { "type": "string", "minLength": 1 },
          "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "permitted_uses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "administrative_settings_path": { "enum": ["app_backed_only", "break_glass_only"] },
          "status": { "enum": ["bounded", "open_deviation"] },
          "next_review": { "type": "string", "format": "date-time" }
        }
      }
    },
    "break_glass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "ordinary_owner", "recovery_owner", "recovery_readiness", "exception_expires_at", "compensating_control", "revocation_procedure", "next_review"],
      "properties": {
        "exists": { "const": true },
        "ordinary_owner": { "const": "fyremael" },
        "recovery_owner": { "const": "jimsteeg" },
        "recovery_readiness": { "enum": ["ready", "blocked_pending_2fa"] },
        "exception_expires_at": { "type": "string", "format": "date-time" },
        "compensating_control": { "type": "string", "minLength": 1 },
        "revocation_procedure": { "type": "string", "minLength": 1 },
        "next_review": { "type": "string", "format": "date-time" }
      }
    },
    "deviations": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_inventory_is_authority", "organization_wide_conformance", "constitutional_authority", "production_authority", "mathematical_authority", "certification_authority"],
      "properties": {
        "credential_inventory_is_authority": { "const": false },
        "organization_wide_conformance": { "const": false },
        "constitutional_authority": { "const": false },
        "production_authority": { "const": false },
        "mathematical_authority": { "const": false },
        "certification_authority": { "const": false }
      }
    }
  },
  "$defs": {
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "status", "expires_at", "compensating_control", "closure_condition", "next_review", "tracking_issue"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "closed"] },
        "expires_at": { "type": "string", "format": "date-time" },
        "compensating_control": { "type": "string", "minLength": 1 },
        "closure_condition": { "type": "string", "minLength": 1 },
        "next_review": { "type": "string", "format": "date-time" },
        "tracking_issue": { "type": "string", "format": "uri" },
        "closed_at": { "type": "string", "format": "date-time" },
        "closure_evidence": { "type": "string", "format": "uri" }
      }
    }
  }
}
